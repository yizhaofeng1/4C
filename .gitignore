# Python/Django .gitignore
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
#  Usually these files are written by a Python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
pytestdebug.log

# Jupyter Notebook
.ipynb_checkpoints

# Django stuff:
*.log
local_settings.py
db.sqlite3
media
staticfiles

# VSCode
.vscode/
.idea/

# Environment
.env
.venv
env/
venv/
ENV/
env.bak/

# OS files
.DS_Store
Thumbs.db

# AI Model weights (too large for Git)
*.bin
*.pt
*.pth
*.onnx
*.safetensors
models/

# Stable Diffusion cache
.cache/

# API keys / secrets
.env.local
*.key
